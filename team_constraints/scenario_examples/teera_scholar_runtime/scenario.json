{
  "scenario_id": "teera_scholar_runtime",
  "description": "Example scenario for workspace results plus isolated runtime event streaming.",
  "project_path": "this_project/feature_TEERA_agent_v2.1",
  "timeout_seconds": 90,
  "workers": [
    {
      "id": "worker_1",
      "run_dir": "worker_1",
      "role": "workspace artifact surface example worker",
      "entrypoint": "worker.py",
      "entrypoint_args": {
        "--worker-role": "workspace_artifact_index"
      }
    },
    {
      "id": "worker_2",
      "run_dir": "worker_2",
      "role": "runtime event stream example worker",
      "entrypoint": "worker.py",
      "entrypoint_args": {
        "--worker-role": "runtime_event_stream"
      }
    }
  ],
  "components": [
    {
      "id": "workspace_artifact_index",
      "owner_worker_role": "workspace_artifact_index",
      "allowed_paths": [
        "src/scholar_retrieval/workspace_index.py",
        "tests/test_workspace_index.py"
      ],
      "rollback": "Revert workspace_index.py and test_workspace_index.py from the worker workspace."
    },
    {
      "id": "runtime_event_stream",
      "owner_worker_role": "runtime_event_stream",
      "allowed_paths": [
        "src/scholar_retrieval/claude_runtime.py",
        "tests/test_claude_runtime.py"
      ],
      "rollback": "Revert claude_runtime.py and test_claude_runtime.py from the worker workspace."
    }
  ],
  "grader": "grader.py"
}
